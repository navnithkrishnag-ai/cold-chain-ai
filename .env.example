# ColdGuard AI - Environment Configuration Example
# Copy this file to .env and configure your values if testing AWS Cloud Mode.
# Never commit real AWS credentials or secrets to version control.

# Execution Mode: "LOCAL" or "AWS"
COLDGUARD_EXECUTION_MODE=LOCAL

# AWS Credentials (Optional - only required for AWS Cloud Mode)
# It is recommended to use AWS IAM roles or ~/.aws/credentials instead of setting these here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Region (Default is ap-south-1 Mumbai)
AWS_DEFAULT_REGION=ap-south-1

# Amazon S3 Bucket for cold-chain datasets and model artifacts
# Example: coldguard-data-storage-<your-unique-suffix>
COLDGUARD_S3_BUCKET=

# Amazon SageMaker Execution Role ARN (Required for SageMaker Training and Batch Inference)
# Example: arn:aws:iam::123456789012:role/ColdGuardSageMakerRole
COLDGUARD_SAGEMAKER_ROLE_ARN=

# Cold-Chain Default Operating Parameters
DEFAULT_MIN_TEMP=2.0
DEFAULT_MAX_TEMP=8.0
DEFAULT_MAX_EXCURSION_MINUTES=30.0
DEFAULT_ANOMALY_SIGMA=3.0
